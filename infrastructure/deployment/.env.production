# =============================================================================
# COA Migration — Production Environment Variables
# Copy this to /opt/coa-migration/.env and update with secure values
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=coa_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
POSTGRES_DB=coa_db

# --- API Service ---
DATABASE_URL=postgresql+asyncpg://coa_user:CHANGE_ME_TO_A_SECURE_PASSWORD@postgres:5432/coa_db
RABBITMQ_URL=amqp://coa_rabbit:CHANGE_ME_RABBIT_PASSWORD@rabbitmq:5672/
CORS_ORIGINS=http://209.38.122.199
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=coa_rabbit
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBIT_PASSWORD

# --- Frontend build ---
API_BASE_URL=http://209.38.122.199/api
APP_ENV=production

# --- Server ---
SERVER_IP=209.38.122.199