# =============================================================================
# COA Migration — Demo Environment
# Copy this file to /opt/coa-migration/environments/demo/.env.demo
# and fill in every CHANGE_ME value before running the compose stack.
# =============================================================================

APP_ENV=demo
DEBUG=false

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=coa_demo_user
POSTGRES_PASSWORD=CHANGE_ME_DEMO_PG_PASSWORD
POSTGRES_DB=coa_demo

DATABASE_URL=postgresql+asyncpg://coa_demo_user:CHANGE_ME_DEMO_PG_PASSWORD@postgres:5432/coa_demo

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_DEMO_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── NATS JetStream ────────────────────────────────────────────────────────────
NATS_URL=nats://nats:4222
NATS_STREAM_NAME=COA_JOBS
NATS_SUBJECT_JOB_RUN=jobs.mapping.run
NATS_SUBJECT_RESULTS=jobs.mapping.status
NATS_STREAM_SUBJECTS=["jobs.mapping.*"]
NATS_STREAM_RETENTION=workqueue
NATS_STREAM_MAX_AGE_SECONDS=86400
NATS_DURABLE_CONSUMER=api-result-consumer

# ── S3-Compatible Storage (DigitalOcean Spaces) ───────────────────────────────
S3_ENDPOINT=https://CHANGE_ME_REGION.digitaloceanspaces.com
S3_ACCESS_KEY=CHANGE_ME_DO_SPACES_KEY
S3_SECRET_KEY=CHANGE_ME_DO_SPACES_SECRET
S3_BUCKET=CHANGE_ME_BUCKET_NAME
S3_REGION=CHANGE_ME_REGION

# ── CORS & URLs ───────────────────────────────────────────────────────────────
# Allow the demo frontend origin.
CORS_ORIGINS=["https://app.dataportation.ai"]
FRONTEND_URL=https://app.dataportation.ai/demo
APP_URL=https://app.dataportation.ai/demo/api
APP_NAME=coa-migration
