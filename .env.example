# Environment (development | testing | staging | production)
APP_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://coa_user:coa_pass@localhost:5432/coa_migration

# PostgreSQL container credentials (used by docker-compose)
POSTGRES_USER=coa_user
POSTGRES_PASSWORD=coa_pass
POSTGRES_DB=coa_migration

# Auth (JWT)
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# NATS JetStream (required — server will not start without a valid NATS_URL)
# Run: docker compose -f src/docker-compose.yml up -d nats
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=COA_JOBS
NATS_SUBJECT_JOB_RUN=jobs.mapping.run
NATS_SUBJECT_RESULTS=jobs.mapping.status
NATS_STREAM_SUBJECTS=["jobs.mapping.*"]
NATS_STREAM_RETENTION=workqueue
NATS_STREAM_MAX_AGE_SECONDS=86400
NATS_DURABLE_CONSUMER=api-result-consumer

# S3-Compatible Storage (DigitalOcean Spaces in production, MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=coa-storage
S3_REGION=us-east-1

# App
APP_NAME=coa-migration
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:8081
APP_URL=http://localhost:8001
