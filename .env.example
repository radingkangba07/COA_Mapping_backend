# Environment (development | testing | staging | production)
APP_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://coa_user:coa_pass@localhost:5432/coa_migration

# Auth (JWT)
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# NATS JetStream (empty = disabled, sync fallback)
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=COA_JOBS

# S3-Compatible Storage (DigitalOcean Spaces in production, MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=coa-storage
S3_REGION=us-east-1

# App
APP_NAME=coa-migration
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
